// Practica 6 - Pipeline de calculadora-descuentos
// PARTE B: esta es la version CON DEFECTOS SEMBRADOS del material.
// Solo se le agrega dir('reto-ci') porque el workspace del job es la raiz
// del monorepo. Los defectos se corrigen despues, un commit por defecto.
pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    options {
        timestamps()
        // Cada build es evidencia de la practica: con 10 se perdian los
        // diagnosticos de la Parte B. El bloque options se reevalua en cada
        // build y pisa la configuracion del job, asi que el numero va aqui.
        buildDiscarder(logRotator(numToKeepStr: '50'))
        timeout(time: 15, unit: 'MINUTES')
    }

    triggers {
        // EJERCICIO 4: se reemplaza el polling por el webhook. Con pollSCM
        // Jenkins se entera del push cada 2 minutos como muy pronto; con
        // githubPush() reacciona al POST que GitHub manda al instante.
        // El polling queda comentado por si hay que comparar.
        // pollSCM('H/2 * * * *')
        githubPush()
    }

    stages {
        stage('Compilar') {
            steps {
                dir('reto-ci') {
                    sh 'mvn -B clean compile'
                }
            }
        }
        stage('Pruebas') {
            steps {
                dir('reto-ci') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    // Publica el informe de JUnit aunque haya pruebas fallidas
                    junit 'reto-ci/target/surefire-reports/*.xml'
                }
            }
        }
        stage('Cobertura') {
            steps {
                dir('reto-ci') {
                    // verify ejecuta la regla de jacoco:check. Si la cobertura de
                    // lineas del BUNDLE baja del 80%, mvn sale distinto de cero,
                    // la etapa queda en rojo y Empaquetar no se ejecuta.
                    sh 'mvn -B verify'
                }
                archiveArtifacts artifacts: 'reto-ci/target/site/jacoco/**', fingerprint: true
            }
        }
        stage('Empaquetar') {
            steps {
                dir('reto-ci') {
                    sh 'mvn -B -DskipTests package'
                }
                archiveArtifacts artifacts: 'reto-ci/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Build y pruebas exitosas'
        }
        unstable {
            echo 'Hay pruebas que fallan: el build queda en amarillo'
        }
        failure {
            echo 'Fallo el proceso: revisa la etapa en rojo'
        }
    }
}
